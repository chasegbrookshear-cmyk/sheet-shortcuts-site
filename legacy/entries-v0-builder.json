{
  "entries": [
    {
      "id": "s001",
      "slug": "copy-cells",
      "kind": "shortcut",
      "title": "Copy cells",
      "meta_description": "Keyboard shortcut to copy selected cells in Excel and Google Sheets, Windows and Mac.",
      "category": "Editing",
      "excel": {
        "windows": "Ctrl+C",
        "mac": "Cmd+C"
      },
      "sheets": {
        "windows": "Ctrl + c",
        "mac": "⌘ + c"
      },
      "notes": "Works the same on both apps; on Mac use Cmd (⌘) instead of Ctrl.",
      "availability": "both",
      "sources": [
        {
          "url": "https://support.microsoft.com/en-us/office/keyboard-shortcuts-in-excel-1798d9d5-842a-42b8-9c99-9b7213f0040f",
          "product": "excel",
          "saved_copy": "sources/copy-cells/ms-shortcuts.txt",
          "quote": "Copy the selected cells. Ctrl+C"
        },
        {
          "url": "https://support.microsoft.com/en-us/office/keyboard-shortcuts-in-excel-1798d9d5-842a-42b8-9c99-9b7213f0040f",
          "product": "excel",
          "saved_copy": "sources/copy-cells/ms-shortcuts.txt",
          "quote": "Copy selection. Cmd+C or Ctrl+C"
        },
        {
          "url": "https://support.google.com/docs/answer/181110?hl=en&co=GENIE.Platform%3DDesktop",
          "product": "sheets",
          "saved_copy": "sources/copy-cells/gs-shortcuts-win.txt",
          "quote": "Copy Ctrl + c"
        },
        {
          "url": "https://support.google.com/docs/answer/181110?hl=en&co=GENIE.Platform%3DDesktop",
          "product": "sheets",
          "saved_copy": "sources/copy-cells/gs-shortcuts-win.txt",
          "quote": "Copy ⌘ + c"
        }
      ]
    },
    {
      "id": "s002",
      "slug": "paste-values-only",
      "kind": "shortcut",
      "title": "Paste values only",
      "meta_description": "Paste only values (no formulas or formatting) in Excel and Google Sheets.",
      "category": "Editing",
      "excel": {
        "windows": "Ctrl+Alt+V",
        "mac": "Cmd+Ctrl+V"
