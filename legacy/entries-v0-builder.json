          "product": "excel",
          "saved_copy": "sources/paste-values-only/ms-shortcuts.txt",
          "quote": "Use Paste Special . Cmd+Ctrl+V"
        },
        {
          "url": "https://support.google.com/docs/answer/181110?hl=en&co=GENIE.Platform%3DDesktop",
          "product": "sheets",
          "saved_copy": "sources/paste-values-only/gs-shortcuts-win.txt",
          "quote": "Paste values only Ctrl + Shift + v"
        },
        {
          "url": "https://support.google.com/docs/answer/181110?hl=en&co=GENIE.Platform%3DDesktop",
          "product": "sheets",
          "saved_copy": "sources/paste-values-only/gs-shortcuts-win.txt",
          "quote": "Paste values only ⌘ + Shift + v"
        }
      ]
    },
