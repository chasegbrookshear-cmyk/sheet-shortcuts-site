      "sheets": {
        "windows": "Ctrl + Shift + v",
        "mac": "⌘ + Shift + v"
      },
      "notes": "Excel's shortcut opens the Paste Special dialog, where you then choose Values. Google Sheets pastes values directly.",
      "availability": "both",
      "sources": [
