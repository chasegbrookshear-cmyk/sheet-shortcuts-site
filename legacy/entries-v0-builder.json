    {
      "id": "f001",
      "slug": "xlookup",
      "kind": "formula",
      "title": "XLOOKUP: find a value in a list",
      "meta_description": "Use XLOOKUP to return a matching value from another column, with a not-found fallback, in Excel and Google Sheets.",
      "category": "Lookup",
      "excel": {
        "formula": "=XLOOKUP(\"Banana\",A2:A4,B2:B4,\"Not found\")"
      },
      "sheets": {
        "formula": "=XLOOKUP(\"Banana\",A2:A4,B2:B4,\"Not found\")"
      },
      "notes": "Excel needs Microsoft 365 / Excel 2021 or later. Prefer XLOOKUP over VLOOKUP: it can look left and defaults to exact match.",
      "example": {
        "cells": {
          "A1": "Fruit",
          "B1": "Price",
          "A2": "Apple",
          "B2": 1.2,
          "A3": "Banana",
          "B3": 0.5,
          "A4": "Cherry",
          "B4": 3
        },
        "formula_cell": "D2",
        "expected": 0.5,
        "explain": "Looks up Banana in A2:A4 and returns its price from B2:B4."
      },
      "availability": "both",
      "sources": [
        {
          "url": "https://support.microsoft.com/en-us/office/xlookup-function-b7fd680e-6d10-43e6-84f9-88eae8bf5929",
          "product": "excel",
          "saved_copy": "sources/xlookup/ms-xlookup.txt",
          "quote": "XLOOKUP(lookup_value, lookup_array, return_array, [if_not_found], [match_mode], [search_mode])"
        },
        {
          "url": "https://support.google.com/docs/answer/12405947?hl=en",
          "product": "sheets",
          "saved_copy": "sources/xlookup/gs-xlookup.txt",
          "quote": "XLOOKUP(search_key, lookup_range, result_range, missing_value, match_mode, search_mode)"
        }
      ]
    },
    {
      "id": "f002",
      "slug": "sumifs",
      "kind": "formula",
      "title": "SUMIFS: sum with several conditions",
      "meta_description": "Add up values that meet multiple conditions with SUMIFS in Excel and Google Sheets.",
      "category": "Math",
      "excel": {
        "formula": "=SUMIFS(B2:B5,A2:A5,\"East\",C2:C5,\"Y\")"
      },
      "sheets": {
        "formula": "=SUMIFS(B2:B5,A2:A5,\"East\",C2:C5,\"Y\")"
      },
      "notes": "The sum range comes FIRST in SUMIFS (unlike SUMIF).",
      "example": {
        "cells": {
          "A1": "Region",
          "B1": "Amount",
          "C1": "Paid",
          "A2": "East",
          "B2": 10,
          "C2": "Y",
          "A3": "West",
          "B3": 20,
          "C3": "Y",
          "A4": "East",
          "B4": 30,
          "C4": "N",
          "A5": "East",
          "B5": 5,
          "C5": "Y"
        },
        "formula_cell": "D2",
        "expected": 15,
        "explain": "Sums Amount where Region is East and Paid is Y: 10 + 5."
      },
      "availability": "both",
      "sources": [
        {
          "url": "https://support.microsoft.com/en-us/office/sumifs-function-c9e748f5-7ea7-455d-9406-611cebce642b",
          "product": "excel",
          "saved_copy": "sources/sumifs/ms-sumifs.txt",
          "quote": "SUMIFS(sum_range, criteria_range1, criteria1, [criteria_range2, criteria2], ...)"
        },
        {
          "url": "https://support.google.com/docs/answer/3238496?hl=en",
          "product": "sheets",
          "saved_copy": "sources/sumifs/gs-sumifs.txt",
          "quote": "SUMIFS(sum_range, criteria_range1, criterion1, [criteria_range2, criterion2, ...])"
        }
      ]
    },
    {
      "id": "f003",
      "slug": "countifs",
      "kind": "formula",
      "title": "COUNTIFS: count rows matching several conditions",
      "meta_description": "Count rows that meet multiple conditions with COUNTIFS in Excel and Google Sheets.",
      "category": "Math",
      "excel": {
        "formula": "=COUNTIFS(A2:A5,\"East\",B2:B5,\">8\")"
      },
      "sheets": {
        "formula": "=COUNTIFS(A2:A5,\"East\",B2:B5,\">8\")"
      },
      "notes": "All criteria ranges must be the same size.",
      "example": {
        "cells": {
          "A1": "Region",
          "B1": "Amount",
          "A2": "East",
          "B2": 10,
          "A3": "West",
          "B3": 20,
          "A4": "East",
          "B4": 30,
          "A5": "East",
          "B5": 5
        },
        "formula_cell": "D2",
        "expected": 2,
        "explain": "Counts East rows with Amount over 8: rows 2 and 4."
      },
      "availability": "both",
      "sources": [
        {
          "url": "https://support.microsoft.com/en-us/office/countifs-function-dda3dc6e-f74e-4aee-88bc-aa8c2a866842",
          "product": "excel",
          "saved_copy": "sources/countifs/ms-countifs.txt",
          "quote": "COUNTIFS(criteria_range1, criteria1, [criteria_range2, criteria2]…)"
        },
        {
          "url": "https://support.google.com/docs/answer/3256550?hl=en",
          "product": "sheets",
          "saved_copy": "sources/countifs/gs-countifs.txt",
          "quote": "COUNTIFS(criteria_range1, criterion1, [criteria_range2, criterion2, ...])"
        }
      ]
    },
    {
      "id": "f004",
      "slug": "iferror",
      "kind": "formula",
      "title": "IFERROR: replace errors with a friendly value",
      "meta_description": "Catch formula errors like #DIV/0! and show your own value with IFERROR in Excel and Google Sheets.",
      "category": "Logic",
      "excel": {
        "formula": "=IFERROR(A2/B2,\"n/a\")"
      },
      "sheets": {
        "formula": "=IFERROR(A2/B2,\"n/a\")"
      },
      "notes": "In Google Sheets the second argument is optional (blank if omitted); include it for Excel.",
      "example": {
        "cells": {
          "A1": "Total",
          "B1": "Count",
          "A2": 10,
          "B2": 0
        },
        "formula_cell": "D2",
        "expected": "n/a",
        "explain": "10/0 is a #DIV/0! error, so the fallback text is returned."
      },
      "availability": "both",
      "sources": [
        {
          "url": "https://support.microsoft.com/en-us/office/iferror-function-c526fd07-caeb-47b8-8bb6-63f3e417f611",
          "product": "excel",
          "saved_copy": "sources/iferror/ms-iferror.txt",
          "quote": "IFERROR(value, value_if_error)"
        },
        {
          "url": "https://support.google.com/docs/answer/3093304?hl=en",
          "product": "sheets",
          "saved_copy": "sources/iferror/gs-iferror.txt",
          "quote": "IFERROR(value, [value_if_error])"
        }
      ]
    },
    {
      "id": "f005",
      "slug": "textjoin",
      "kind": "formula",
      "title": "TEXTJOIN: combine text with a separator",
      "meta_description": "Join a range of text with a delimiter and skip blanks using TEXTJOIN in Excel and Google Sheets.",
      "category": "Text",
      "excel": {
        "formula": "=TEXTJOIN(\", \",TRUE,A2:A4)"
      },
      "sheets": {
        "formula": "=TEXTJOIN(\", \",TRUE,A2:A4)"
      },
      "notes": "Excel needs Excel 2019 / Microsoft 365 or later.",
      "example": {
        "cells": {
          "A1": "Color",
          "A2": "red",
          "A3": "",
          "A4": "blue"
        },
        "formula_cell": "D2",
        "expected": "red, blue",
        "explain": "TRUE skips the empty A3, giving red, blue."
      },
      "availability": "both",
      "sources": [
        {
          "url": "https://support.microsoft.com/en-us/office/textjoin-function-357b449a-ec91-49d0-80c3-0e8fc845691c",
          "product": "excel",
          "saved_copy": "sources/textjoin/ms-textjoin.txt",
          "quote": "TEXTJOIN(delimiter, ignore_empty, text1, [text2], …)"
        },
        {
          "url": "https://support.google.com/docs/answer/7013992?hl=en",
          "product": "sheets",
          "saved_copy": "sources/textjoin/gs-textjoin.txt",
          "quote": "TEXTJOIN(delimiter, ignore_empty, text1, [text2, ...])"
        }
      ]
    }
  ]
}